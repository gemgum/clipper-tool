{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipper",
  "version": "0.7.2",
  "identifier": "com.gemgum.clipper",
  "build": {
    "frontendDist": "../placeholder"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipper",
        "width": 1240,
        "height": 860,
        "minWidth": 1240,
        "minHeight": 860,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Long videos into 9:16 clips",
    "longDescription": "Cuts long videos into short 9:16 clips with subtitles and a viral score."
  }
}
